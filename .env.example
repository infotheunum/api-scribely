# Copy to .env for local dev:
#   cp .env.example .env
#
# Real values go in Railway Variables per service on deploy — never commit .env.

# =============================================================================
# МИНИМУМ ДЛЯ ЛОКАЛЬНОГО ЗАПУСКА
# =============================================================================
#
# 1. Инструменты: Python 3.12 + uv (+ Docker для Postgres). См. README.md.
# 2. Postgres на localhost:5432, БД unum_news (см. README → «База данных»).
# 3. alembic upgrade head
# 4. Три процесса в отдельных терминалах:
#      python -m rewrite_app.server          # gRPC :50051
#      uvicorn api_app.main:app --reload --port 8000
#      uvicorn worker_app.main:app --reload --port 8001
# 5. Проверка: curl localhost:8000/health && curl localhost:8000/health/rewrite
#
# Обязательные переменные ниже — только DATABASE_URL, если Postgres не на
# дефолтном хосте/порте. Остальное уже имеет безопасные dev-дефолты в коде
# (libs/common/settings.py, services/api/app/settings.py), но лучше явно
# прописать в .env, чтобы все три сервиса читали одно и то же.

# --- Shared (api + worker + rewrite) ---
ENVIRONMENT=development
LOG_LEVEL=INFO
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/unum_news
REWRITE_GRPC_ADDRESS=localhost:50051
# Один и тот же токен во всех трёх сервисах (gRPC auth api/worker → rewrite).
INTERNAL_SERVICE_TOKEN=dev-insecure-service-token

# --- api only ---
# PORT=8000   # uvicorn --port в CLI; в Railway подставляет Railway.
JWT_SECRET=dev-insecure-jwt-secret
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=720

# --- rewrite only ---
# gRPC-порт задаётся rewrite_app (по умолчанию 50051), не путать с Railway PORT.

# =============================================================================
# ДЛЯ ВХОДА В UI (не нужны, чтобы просто поднять /health)
# =============================================================================
#
# После миграций один раз:
#   python scripts/seed_admin.py
#   python scripts/seed_rewriter.py
#   python scripts/seed_sources.py   # опционально, источники RSS
#
# Логин: http://localhost:8000/ui/login

ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-local-admin
ADMIN_DISPLAY_NAME=UNUM Admin (local)
REWRITER_USERNAME=rewriter
REWRITER_PASSWORD=change-me-local-rewriter
REWRITER_DISPLAY_NAME=UNUM Rewriter (local)

# =============================================================================
# ДЛЯ AI-РЕРАЙТА (только сервис rewrite на Railway / локально)
# =============================================================================
#
# OpenRouter free-tier, 3 ключа для Rotation Manager (ТЗ §4.5).
# Только в scribely-rewrite; без ключей health OK, но RewriteCluster упадёт
# при реальном вызове LLM.
#
# https://openrouter.ai/keys

OPENROUTER_KEY_1=
OPENROUTER_KEY_2=
OPENROUTER_KEY_3=

# =============================================================================
# ИНТЕГРАЦИЯ api-scribely ↔ api.theunum.io (cron export черновиков)
# =============================================================================
#
# Сгенерировать один общий секрет (положить в ОБА проекта):
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
#
# --- api-scribely (этот репо) — Railway сервис `api` ---
#
# THEUNUM_INTEGRATION_TOKEN=<тот же секрет>
# CORS_ALLOWED_ORIGINS=   # опционально; для cron с VPS не нужен
#
# --- api.theunum.io (VPS) — cron тянет черновики ОТСЮДА ---
#
# SCRIBELY_BASE_URL=https://api-scribely-production.up.railway.app
# SCRIBELY_INTEGRATION_TOKEN=<тот же секрет, что THEUNUM_INTEGRATION_TOKEN>
#
# Cron flow:
#   GET  $SCRIBELY_BASE_URL/integrations/theunum/v1/drafts
#   POST $SCRIBELY_BASE_URL/integrations/theunum/v1/drafts/mark-consumed
#   GET  $SCRIBELY_BASE_URL/integrations/theunum/v1/status   (мониторинг)
#
# Header: Authorization: Bearer <SCRIBELY_INTEGRATION_TOKEN>
#
# Локально для теста integration API:
THEUNUM_INTEGRATION_TOKEN=dev-insecure-theunum-integration-token
# CORS_ALLOWED_ORIGINS=https://admin.theunum.io,http://localhost:3000
