# Copy to .env for local dev. Real values go in Railway Variables per
# service in deploy — never commit .env (see .gitignore).

# --- Shared (all 3 services, libs/common/settings.py) ---
ENVIRONMENT=development
LOG_LEVEL=INFO
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/unum_news
REWRITE_GRPC_ADDRESS=localhost:50051
# Shared secret api/worker present to rewrite over Railway private
# networking (ТЗ §5, §6.6, решение 32) — generate a real random value
# before any non-local deploy.
INTERNAL_SERVICE_TOKEN=dev-insecure-service-token

# --- api only (services/api/app/settings.py) ---
PORT=8000
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=dev-insecure-jwt-secret
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=720

# --- rewrite only (services/rewrite/app/settings.py) ---
# PORT=50051

# --- OpenRouter (rewrite only, wired up in Phase 4 — ТЗ §4.5) ---
# 3 keys for the Rotation Manager to cycle through once free-tier limits
# are hit on one key; kept in scribely-rewrite only, never in api/worker.
OPENROUTER_KEY_1=
OPENROUTER_KEY_2=
OPENROUTER_KEY_3=
